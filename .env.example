# Copy to .env. Everything here is read once at boot; restart after changing.
PORT=3040
NODE_ENV=production
# Public URL of the league site (used to build the webhook URL shown in admin).
BASE_URL=https://registration.crushworldseries.com
LEAGUE_NAME=SE Baseball
LEAGUE_URL=https://registration.crushworldseries.com

# Admin accounts shared by every league tool, and the cookie domain that makes
# one login work across the subdomains.
AUTH_DB_PATH=/home/greg/apps/league-data/auth.db
COOKIE_DOMAIN=.crushworldseries.com

# Hostnames that open straight into one draft room: host=season/division-key, comma-separated.
DRAFT_HOSTS=2027majordraft.crushworldseries.com=2027/majors

# Optional shared code viewers must enter. Blank = seat counts and draft boards are public
# (they never show eval notes; seat counts never show names).
VIEWER_PASSWORD=

# --- SportsEngine registration webhooks -----------------------------------
#   POST {BASE_URL}/webhooks/sportsengine/{SPORTSENGINE_WEBHOOK_TOKEN}
SPORTSENGINE_WEBHOOK_TOKEN=
SPORTSENGINE_WEBHOOK_SECRET=
SPORTSENGINE_SIGNATURE_HEADER=x-sportsengine-signature
