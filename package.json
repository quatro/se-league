{
  "name": "se-league",
  "version": "1.0.0",
  "description": "SE Baseball league app: seasons, kids over time, registration seats, Majors and Minors drafts",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "admin": "tsx scripts/admin.ts",
    "test": "tsx --test test/*.test.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
